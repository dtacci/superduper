<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>SuperduperDictation</string>
	<key>CFBundleIconName</key>
	<string>SuperduperDictation</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Superduper Dictation</string>
	<key>CFBundleDisplayName</key>
	<string>Superduper Dictation</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Superduper Dictation records call and app audio so meeting transcripts include the other participants.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Superduper Dictation needs microphone access to transcribe your voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Superduper Dictation uses on-device speech recognition to transcribe your audio without sending data to any server.</string>
	<!-- Filled from GOOGLE_CALENDAR_CLIENT_ID / _SECRET in a local .env by the just
	     build recipes (see .env.example); empty in CI and plain Xcode builds.
	     Developers can override at runtime with SUPERDUPER_GOOGLE_CLIENT_ID / _SECRET. -->
	<key>GoogleCalendarClientID</key>
	<string>$(GOOGLE_CALENDAR_CLIENT_ID)</string>
	<key>GoogleCalendarClientSecret</key>
	<string>$(GOOGLE_CALENDAR_CLIENT_SECRET)</string>
</dict>
</plist>
