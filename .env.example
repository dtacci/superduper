# Copy to .env (gitignored) and fill in. The just build recipes compile these
# into Info.plist so Google Calendar sign-in needs no pasted client on any Mac.
#
# Create them once in Google Cloud Console (APIs & Services): enable the Google
# Calendar API, set the OAuth consent screen to External and publish it
# ("In production", so sign-ins don't expire after 7 days), then create an
# OAuth client of type "Desktop app".
#
# Google treats a Desktop app's secret as non-confidential, but anyone with a
# build can read both values, so never commit them to this public repo.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
